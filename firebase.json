{
  "hosting": {
    "site": "bulmeong",
    "public": "firebase-public",
    "trailingSlash": true,
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
